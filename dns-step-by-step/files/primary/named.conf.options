acl confiables {
    127.0.0.1;
    192.168.56.0/24;
};

options {
    directory "/var/cache/bind";

    // forwarders {
    //   0.0.0.0;
    // };

    allow-transfer { none; };
    listen-on port 53 { 127.0.0.1; 192.168.56.10; };

    recursion yes;
    allow-recursion { confiables; };

    dnssec-validation auto;

    // listen-on-v6 { any; };
};
